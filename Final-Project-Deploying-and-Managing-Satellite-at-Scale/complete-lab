Subtask 3.5: Configure Performance Monitoring
Set up performance monitoring and optimization.

# Create performance monitoring script
cat > /root/performance_monitor.sh << 'EOF'
#!/bin/bash

PERF_LOG="/var/log/satellite_performance.log"
DATE=$(date '+%Y-%m-%d %H:%M:%S')

# System performance metrics
CPU_USAGE=$(top -bn1 | grep "Cpu(s)" | awk '{print $2}' | sed 's/%us,//')
MEMORY_USAGE=$(free | grep Mem | awk '{printf "%.2f", $3/$2 * 100.0}')
LOAD_AVERAGE=$(uptime | awk -F'load average:' '{print $2}')

# Database performance
DB_SIZE=$(sudo -u postgres psql -t -c "SELECT pg_size_pretty(pg_database_size('foreman'));" foreman | xargs)
DB_CONNECTIONS=$(sudo -u postgres psql -t -c "SELECT count(*) FROM pg_stat_activity;" foreman | xargs)

# Log performance metrics
echo "[$DATE] CPU: ${CPU_USAGE}%, Memory: ${MEMORY_USAGE}%, Load: ${LOAD_AVERAGE}" >> $PERF_LOG
echo "[$DATE] DB Size: $DB_SIZE, DB Connections: $DB_CONNECTIONS" >> $PERF_LOG

# Check for performance issues
if (( $(echo "$MEMORY_USAGE > 90" | bc -l) )); then
    echo "[$DATE] ALERT: High memory usage: ${MEMORY_USAGE}%" >> $PERF_LOG
fi
EOF

chmod +x /root/performance_monitor.sh

