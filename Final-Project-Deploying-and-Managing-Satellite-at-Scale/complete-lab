#!/bin/bash

LOG_FILE="/var/log/satellite_monitor.log"
DATE=$(date '+%Y-%m-%d %H:%M:%S')

# Function to log messages
log_message() {
    echo "[$DATE] $1" >> $LOG_FILE
}

# Check Satellite services
SERVICES=("httpd" "postgresql" "pulpcore-worker@1" "pulpcore-worker@2" "redis" "foreman")

for service in "${SERVICES[@]}"; do
    if systemctl is-active --quiet $service; then
        log_message "OK: $service is running"
    else
        log_message "CRITICAL: $service is not running"
        # Send alert (configure email/notification here)
    fi
done

# Check disk space
DISK_USAGE=$(df /var | awk 'NR==2 {print $5}' | sed 's/%//')
if [ $DISK_USAGE -gt 80 ]; then
    log_message "WARNING: Disk usage is ${DISK_USAGE}%"
fi

# Check database connections
DB_CONNECTIONS=$(sudo -u postgres psql -t -c "SELECT count(*) FROM pg_stat_activity;" foreman)
log_message "INFO: Database connections: $DB_CONNECTIONS"

# Check content synchronization status
SYNC_STATUS=$(hammer repository list --organization "Example Organization" --fields "Name,Last sync" | grep -c "Success")
log_message "INFO: Successful repository syncs: $SYNC_STATUS"
EOF

chmod +x /root/satellite_monitor.sh

