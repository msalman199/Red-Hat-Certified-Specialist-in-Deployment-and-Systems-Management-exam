Troubleshooting Guide
Common Issues and Solutions
Issue 1: PXE Boot Fails
# Check DHCP configuration
systemctl status dhcpd
tail -f /var/log/dhcpd.log

# Verify TFTP service
systemctl status xinetd
netstat -ulnp | grep :69

# Check PXE files
ls -la /var/lib/tftpboot/
Issue 2: Kickstart Download Fails
# Verify HTTP service
systemctl status httpd
curl -I http://satellite.example.com/unattended/provision

# Check template rendering
hammer template dump --name "Custom RHEL Kickstart"
Issue 3: Host Registration Fails
# Check Satellite connectivity
curl -k https://satellite.example.com/api/status

# Verify certificates
katello-certs-check -c /etc/pki/katello/certs/katello-apache.crt \
                   -k /etc/pki/katello/private/katello-apache.key \
                   -b /etc/pki/katello-certs-tools/certs/katello-server-ca.crt
