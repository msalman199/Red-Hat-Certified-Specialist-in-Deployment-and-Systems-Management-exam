Subtask 2.3: Set Up Automated Drift Monitoring
Create systemd service for drift monitoring:

cat > /etc/systemd/system/config-drift-monitor.service << 'EOF'
[Unit]
Description=Configuration Drift Monitor
After=network.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/config-drift-monitor.sh
User=root

[Install]
WantedBy=multi-user.target
EOF
Create timer for regular monitoring:

cat > /etc/systemd/system/config-drift-monitor.timer << 'EOF'
[Unit]
Description=Run Configuration Drift Monitor every 4 hours
Requires=config-drift-monitor.service

[Timer]
OnCalendar=*-*-* 00,04,08,12,16,20:00:00
Persistent=true

[Install]
WantedBy=timers.target
EOF

# Enable and start the timer
systemctl daemon-reload
systemctl enable config-drift-monitor.timer
systemctl start config-drift-monitor.timer

# Check timer status
systemctl list-timers config-drift-monitor.timer
Task 3: Create Custom Reports on System Performance and Patch Levels
Subtask 3.1: Develop System Performance Monitoring Scripts
Create comprehensive system performance script:

cat > /usr/local/bin/system-performance-report.sh << 'EOF'
#!/bin/bash

# System Performance Report Generator
REPORT_DIR="/var/reports/performance"
TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
REPORT_FILE="$REPORT_DIR/performance_report_$TIMESTAMP.txt"

# Create report directory
mkdir -p $REPORT_DIR

# Function to generate performance report
generate_performance_report() {
    echo "System Performance Report - $(date)" > $REPORT_FILE
    echo "============================================" >> $REPORT_FILE
    echo "" >> $REPORT_FILE
    
    # System Information
    echo "SYSTEM INFORMATION:" >> $REPORT_FILE
    echo "Hostname: $(hostname)" >> $REPORT_FILE
    echo "Uptime: $(uptime)" >> $REPORT_FILE
    echo "Kernel: $(uname -r)" >> $REPORT_FILE
    echo "" >> $REPORT_FILE
    
    # CPU Usage
    echo "CPU USAGE:" >> $REPORT_FILE
    echo "Current CPU usage:" >> $REPORT_FILE
    top -bn1 | grep "Cpu(s)" >> $REPORT_FILE
    echo "" >> $REPORT_FILE
    echo "Load Average:" >> $REPORT_FILE
    cat /proc/loadavg >> $REPORT_FILE
    echo "" >> $REPORT_FILE
    
    # Memory Usage
    echo "MEMORY USAGE:" >> $REPORT_FILE
    free -h >> $REPORT_FILE
    echo "" >> $REPORT_FILE
    
    # Disk Usage
    echo "DISK USAGE:" >> $REPORT_FILE
    df -h >> $REPORT_FILE
    echo "" >> $REPORT_FILE
    
    # Network Statistics
    echo "NETWORK STATISTICS:" >> $REPORT_FILE
    cat /proc/net/dev >> $REPORT_FILE
    echo "" >> $REPORT_FILE
    
    # Process Information
    echo "TOP PROCESSES BY CPU:" >> $REPORT_FILE
    ps aux --sort=-%cpu | head -10 >> $REPORT_FILE
    echo "" >> $REPORT_FILE
    
    echo "TOP PROCESSES BY MEMORY:" >> $REPORT_FILE
    ps aux --sort=-%mem | head -10 >> $REPORT_FILE
    echo "" >> $REPORT_FILE
    
    # Service Status
    echo "CRITICAL SERVICES STATUS:" >> $REPORT_FILE
    for service in sshd httpd chronyd NetworkManager; do
        if systemctl is-active --quiet $service; then
            echo "$service: RUNNING" >> $REPORT_FILE
        else
            echo "$service: STOPPED" >> $REPORT_FILE
        fi
    done
    echo "" >> $REPORT_FILE
}

# Generate the report
generate_performance_report
echo "Performance report generated: $REPORT_FILE"

# Create symlink to latest report
ln -sf $REPORT_FILE $REPORT_DIR/latest_performance_report.txt
EOF

chmod +x /usr/local/bin/system-performance-report.sh
Create patch level analysis script:

cat > /usr/local/bin/patch-level-report.sh << 'EOF'
#!/bin/bash

# Patch Level Report Generator
REPORT_DIR="/var/reports/patches"
TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
REPORT_FILE="$REPORT_DIR/patch_report_$TIMESTAMP.txt"

# Create report directory
mkdir -p $REPORT_DIR

# Function to generate patch report
generate_patch_report() {
    echo "System Patch Level Report - $(date)" > $REPORT_FILE
    echo "========================================" >> $REPORT_FILE
    echo "" >> $REPORT_FILE
    
    # System Information
    echo "SYSTEM INFORMATION:" >> $REPORT_FILE
    echo "Hostname: $(hostname)" >> $REPORT_FILE
    echo "OS Version: $(cat /etc/redhat-release)" >> $REPORT_FILE
    echo "Kernel Version: $(uname -r)" >> $REPORT_FILE
    echo "" >> $REPORT_FILE
    
    # Available Updates
    echo "AVAILABLE UPDATES:" >> $REPORT_FILE
    yum check-update > /tmp/updates_available.txt 2>&1
    if [ $? -eq 100 ]; then
        echo "Updates are available:" >> $REPORT_FILE
        cat /tmp/updates_available.txt >> $REPORT_FILE
    else
        echo "System is up to date" >> $REPORT_FILE
    fi
    echo "" >> $REPORT_FILE
    
    # Security Updates
    echo "SECURITY UPDATES:" >> $REPORT_FILE
    yum --security check-update > /tmp/security_updates.txt 2>&1
    if [ $? -eq 100 ]; then
        echo "Security updates available:" >> $REPORT_FILE
        cat /tmp/security_updates.txt >> $REPORT_FILE
    else
        echo "No security updates available" >> $REPORT_FILE
    fi
    echo "" >> $REPORT_FILE
    
    # Recently Installed Packages
    echo "RECENTLY INSTALLED PACKAGES (Last 30 days):" >> $REPORT_FILE
    rpm -qa --last | head -20 >> $REPORT_FILE
    echo "" >> $REPORT_FILE
    
    # Package Count Summary
    echo "PACKAGE SUMMARY:" >> $REPORT_FILE
    echo "Total installed packages: $(rpm -qa | wc -l)" >> $REPORT_FILE
    echo "Available updates: $(yum list updates 2>/dev/null | grep -v "Updated Packages" | grep -v "Available Upgrades" | wc -l)" >> $REPORT_FILE
    echo "" >> $REPORT_FILE
    
    # Cleanup temporary files
    rm -f /tmp/updates_available.txt /tmp/security_updates.txt
}

# Generate the report
generate_patch_report
echo "Patch report generated: $REPORT_FILE"

# Create symlink to latest report
ln -sf $REPORT_FILE $REPORT_DIR/latest_patch_report.txt
EOF

chmod +x /usr/local/bin/patch-level-report.sh
