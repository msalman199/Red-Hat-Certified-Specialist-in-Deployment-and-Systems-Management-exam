Subtask 2.2: Implement Configuration Drift Detection
Create configuration monitoring script:

cat > /usr/local/bin/config-drift-monitor.sh << 'EOF'
#!/bin/bash

# Configuration Drift Detection Script
BASELINE_DIR="/var/lib/config-baseline"
CURRENT_DIR="/tmp/current-config"
REPORT_FILE="/var/log/config-drift-report.log"

# Create directories
mkdir -p $BASELINE_DIR $CURRENT_DIR

# Function to capture current configuration
capture_config() {
    echo "Capturing current configuration..."
    
    # System configuration files
    cp /etc/ssh/sshd_config $CURRENT_DIR/
    cp /etc/sudoers $CURRENT_DIR/
    cp /etc/passwd $CURRENT_DIR/
    cp /etc/group $CURRENT_DIR/
    
    # Service status
    systemctl list-units --state=running > $CURRENT_DIR/running_services.txt
    
    # Installed packages
    rpm -qa | sort > $CURRENT_DIR/installed_packages.txt
    
    # Network configuration
    ip addr show > $CURRENT_DIR/network_config.txt
}

# Function to compare configurations
compare_config() {
    echo "Comparing configurations..."
    echo "Configuration Drift Report - $(date)" > $REPORT_FILE
    echo "========================================" >> $REPORT_FILE
    
    for file in $CURRENT_DIR/*; do
        filename=$(basename $file)
        baseline_file="$BASELINE_DIR/$filename"
        
        if [ -f "$baseline_file" ]; then
            if ! diff -q "$baseline_file" "$file" > /dev/null; then
                echo "DRIFT DETECTED: $filename" >> $REPORT_FILE
                echo "Differences:" >> $REPORT_FILE
                diff "$baseline_file" "$file" >> $REPORT_FILE
                echo "---" >> $REPORT_FILE
            fi
        else
            echo "NEW FILE: $filename" >> $REPORT_FILE
        fi
    done
}

# Main execution
capture_config

# If baseline doesn't exist, create it
if [ ! "$(ls -A $BASELINE_DIR)" ]; then
    echo "Creating baseline configuration..."
    cp -r $CURRENT_DIR/* $BASELINE_DIR/
    echo "Baseline created. Run again to detect drift."
else
    compare_config
    echo "Drift detection complete. Check $REPORT_FILE for results."
fi
EOF

chmod +x /usr/local/bin/config-drift-monitor.sh
Run configuration drift detection:

# Create initial baseline
/usr/local/bin/config-drift-monitor.sh

# Make a configuration change to test drift detection
echo "# Test comment for drift detection" >> /etc/ssh/sshd_config

# Run drift detection again
/usr/local/bin/config-drift-monitor.sh

# View the drift report
