#!/bin/bash
# Backup Validation Script

BACKUP_DIR="/backup"
VALIDATION_LOG="/var/log/backup-validation.log"

validate_db_backup() {
    LATEST_DB_BACKUP=$(ls -t $BACKUP_DIR/database/ | head -1)
    
    if [ -z "$LATEST_DB_BACKUP" ]; then
        echo "$(date): No database backups found" >> $VALIDATION_LOG
        return 1
    fi
    
    # Test if backup files can be read
    for file in $BACKUP_DIR/database/$LATEST_DB_BACKUP/*.sql.gz; do
        if ! gunzip -t "$file" 2>/dev/null; then
            echo "$(date): Corrupted backup file: $file" >> $VALIDATION_LOG
            return 1
        fi
    done
    
    echo "$(date): Database backup validation successful: $LATEST_DB_BACKUP" >> $VALIDATION_LOG
    return 0
}

validate_config_backup() {
    LATEST_CONFIG_BACKUP=$(ls -t $BACKUP_DIR/configs/ | head -1)
    
    if [ -z "$LATEST_CONFIG_BACKUP" ]; then
        echo "$(date): No configuration backups found" >> $VALIDATION_LOG
        return 1
    fi
    
    # Check if backup directory contains expected files
    if [ ! -f "$BACKUP_DIR/configs/$LATEST_CONFIG_BACKUP/config_files.tar.gz" ]; then
        echo "$(date): Configuration backup incomplete: $LATEST_CONFIG_BACKUP" >> $VALIDATION_LOG
        return 1
    fi
    
    echo "$(date): Configuration backup validation successful: $LATEST_CONFIG_BACKUP" >> $VALIDATION_LOG
    return 0
}

