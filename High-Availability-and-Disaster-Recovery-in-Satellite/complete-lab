Create database backup script:
sudo vi /usr/local/bin/satellite-db-backup.sh
#!/bin/bash
# Satellite Database Backup Script

BACKUP_DIR="/backup/database"
DATE=$(date +%Y%m%d_%H%M%S)
DB_HOST="satellite-primary"
DB_NAME="foreman"
DB_USER="foreman"

# Create backup directory
mkdir -p $BACKUP_DIR/$DATE

# Backup PostgreSQL database
echo "Starting database backup..."
pg_dump -h $DB_HOST -U $DB_USER -d $DB_NAME -f $BACKUP_DIR/$DATE/foreman_$DATE.sql

# Backup Candlepin database
pg_dump -h $DB_HOST -U candlepin -d candlepin -f $BACKUP_DIR/$DATE/candlepin_$DATE.sql

# Compress backups
gzip $BACKUP_DIR/$DATE/*.sql

# Remove backups older than 30 days
find $BACKUP_DIR -type d -mtime +30 -exec rm -rf {} \;

echo "Database backup completed: $BACKUP_DIR/$DATE"
Create configuration backup script:
sudo vi /usr/local/bin/satellite-config-backup.sh
#!/bin/bash
# Satellite Configuration Backup Script

BACKUP_DIR="/backup/configs"
DATE=$(date +%Y%m%d_%H%M%S)
SATELLITE_HOST="satellite-primary"

# Create backup directory
mkdir -p $BACKUP_DIR/$DATE

# Backup important configuration directories
echo "Backing up Satellite configurations..."

# Backup using satellite-maintain
ssh root@$SATELLITE_HOST "satellite-maintain backup offline --preserve-directory /tmp/satellite-backup-$DATE"

# Copy backup to backup server
rsync -avz root@$SATELLITE_HOST:/tmp/satellite-backup-$DATE/ $BACKUP_DIR/$DATE/

# Cleanup remote backup
ssh root@$SATELLITE_HOST "rm -rf /tmp/satellite-backup-$DATE"

echo "Configuration backup completed: $BACKUP_DIR/$DATE"
