#!/bin/bash
# Satellite Health Monitoring Script

LOG_FILE="/var/log/satellite-health.log"
EMAIL="admin@company.com"

# Function to log messages
log_message() {
    echo "$(date): $1" >> $LOG_FILE
}

# Check Satellite services
check_services() {
    FAILED_SERVICES=""
    
    for service in httpd postgresql foreman dynflowd; do
        if ! systemctl is-active --quiet $service; then
            FAILED_SERVICES="$FAILED_SERVICES $service"
        fi
    done
    
    if [ -n "$FAILED_SERVICES" ]; then
        log_message "CRITICAL: Failed services:$FAILED_SERVICES"
        echo "CRITICAL: Satellite services failed:$FAILED_SERVICES" | mail -s "Satellite Alert" $EMAIL
        return 1
    fi
    
    return 0
}

# Check database connectivity
check_database() {
    if ! sudo -u postgres psql -d foreman -c "SELECT 1;" > /dev/null 2>&1; then
        log_message "CRITICAL: Database connectivity failed"
        echo "CRITICAL: Satellite database is not accessible" | mail -s "Satellite Database Alert" $EMAIL
        return 1
    fi
    
    return 0
}

# Check disk space
check_disk_space() {
    USAGE=$(df /var | tail -1 | awk '{print $5}' | sed 's/%//')
    
    if [ $USAGE -gt 90 ]; then
        log_message "WARNING: Disk usage is ${USAGE}%"
        echo "WARNING: Satellite disk usage is ${USAGE}%" | mail -s "Satellite Disk Alert" $EMAIL
        return 1
    fi
    
    return 0
}

# Main health check
main() {
    log_message "Starting health check"
    
    check_services
    check_database
    check_disk_space
    
    log_message "Health check completed"
}

main
