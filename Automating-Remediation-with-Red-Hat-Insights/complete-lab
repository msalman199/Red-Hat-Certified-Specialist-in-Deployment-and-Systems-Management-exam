Subtask 3.3: Validate Remediation Results
Create a validation script:
sudo nano /opt/insights-remediation/validate.sh
Add validation script content:
#!/bin/bash

# Insights Remediation Validation Script

VALIDATION_LOG="/var/log/insights-validation.log"

# Function to log validation results
log_validation() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" | tee -a "$VALIDATION_LOG"
}

echo "=== Red Hat Insights Remediation Validation ==="

# Test 1: Verify Insights registration
log_validation "Testing Insights registration..."
if insights-client --status | grep -q "Successfully registered"; then
    log_validation "PASS: System is registered with Red Hat Insights"
else
    log_validation "FAIL: System is not properly registered"
fi

# Test 2: Check if remediation service is enabled
log_validation "Testing remediation service configuration..."
if systemctl is-enabled insights-remediation.timer >/dev/null 2>&1; then
    log_validation "PASS: Remediation timer is enabled"
else
    log_validation "FAIL: Remediation timer is not enabled"
fi

# Test 3: Verify log file exists and has recent entries
log_validation "Testing log file accessibility..."
if [ -f /var/log/insights-remediation.log ]; then
    LAST_LOG_ENTRY=$(tail -1 /var/log/insights-remediation.log 2>/dev/null)
    if [ -n "$LAST_LOG_ENTRY" ]; then
        log_validation "PASS: Remediation log file exists and has entries"
        log_validation "Last entry: $LAST_LOG_ENTRY"
    else
        log_validation "WARN: Log file exists but appears empty"
    fi
else
    log_validation "WARN: Remediation log file does not exist yet"
fi

# Test 4: Check DNF automatic configuration
log_validation "Testing DNF automatic configuration..."
if systemctl is-active dnf-automatic.timer >/dev/null 2>&1; then
    log_validation "PASS: DNF automatic timer is active"
else
    log_validation "FAIL: DNF automatic timer is not active"
fi

# Test 5: Verify network connectivity to Red Hat services
log_validation "Testing connectivity to Red Hat services..."
if curl -s --connect-timeout 10 https://cert-api.access.redhat.com/r/insights >/dev/null; then
    log_validation "PASS: Can connect to Red Hat Insights API"
else
    log_validation "FAIL: Cannot connect to Red Hat Insights API"
fi

# Test 6: Check for recent Insights data collection
log_validation "Testing recent data collection..."
INSIGHTS_LAST_RUN=$(find /var/lib/insights -name "*.json" -mtime -1 2>/dev/null | wc -l)
if [ "$INSIGHTS_LAST_RUN" -gt 0 ]; then
    log_validation "PASS: Recent Insights data found"
else
    log_validation "WARN: No recent Insights data found"
fi

log_validation "Validation completed. Check $VALIDATION_LOG for detailed results."
echo
echo "Validation log saved to: $VALIDATION_LOG"
